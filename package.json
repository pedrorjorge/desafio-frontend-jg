{
  "name": "kurio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run mocks:worker && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "mocks:worker": "node -e \"require('node:fs').mkdirSync('public', { recursive: true })\" && msw init public --no-save",
    "predev": "npm run mocks:worker",
    "build:demo": "npm run typecheck && npm run mocks:worker && vite build --mode demo",
    "test:e2e": "playwright test tests/e2e",
    "test:visual": "playwright test tests/visual",
    "test:visual:update": "playwright test tests/visual --update-snapshots",
    "test:report": "playwright show-report",
    "audit:lighthouse": "node scripts/audit-lighthouse.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-router": "^1.120.5",
    "axios": "^1.15.0",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "msw": "2.13.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.72.1",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "1.58.2",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^22.19.17",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "lighthouse": "12.8.2",
    "prettier": "^3.8.2",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^7.3.2"
  }
}
